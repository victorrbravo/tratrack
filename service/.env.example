ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
PORT=8080
# nominatim (default, no key) | google | mock
GEOCODER=nominatim
GOOGLE_MAPS_API_KEY=
# Stories service: POST $STORIES_API_URL/steps {"command":"add_step ..."} -> {"id":"..."}
# Leave empty to use the local stub that returns generated step ids.
STORIES_API_URL=
STORIES_API_TOKEN=
TRATRACK_JOB_TIMEOUT=15m
# Offline demo without any API key: TRATRACK_MOCK=true

# Analysis gRPC service
GRPC_ADDR=:50051
# Real analysis takes 5-8 min; shorten for demos/tests, e.g. ANALYSIS_DURATION=10s
ANALYSIS_DURATION=5m
# Muse API key — set this to run the real 4-step pipeline; leave empty for simulated mode
MODEL_API_KEY=
# City or country used to geocode places (default: Paris)
ANALYSIS_LOCATION=Paris
